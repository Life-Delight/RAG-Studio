# ===== RAG-Studio 后端配置示例 =====
# 使用方法：把本文件复制为 .env，填入你自己的真实配置。
# .env 已被 .gitignore 忽略，不会提交到仓库；请勿把真实密钥写进代码或本文件。

# ---- 大语言模型（OpenAI 兼容接口，默认对接 DeepSeek 官方）----
OLLAMA_BASE_URL=https://api.deepseek.com/v1
OLLAMA_MODEL=deepseek-chat
# 在 https://platform.deepseek.com 申请自己的 API Key，替换下面的占位值
LLM_API_KEY=sk-your-own-deepseek-api-key

# ---- 向量模型 ----
# 留空则使用代码默认值（HuggingFace 名称，首次运行会自动下载）
# 也可指向本地目录（启动脚本默认使用项目内 models/minilm-l12-v2）
# EMBED_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- 国内下载模型使用的 HuggingFace 镜像 ----
HF_ENDPOINT=https://hf-mirror.com

# ---- 检索参数（可选，留空用默认值）----
# TOP_K=20
# MIN_RELEVANCE_SCORE=0.55
